NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider: zhipu | deepseek | dashscope
AI_PROVIDER=zhipu
AI_API_KEY=
AI_MODEL=glm-4.5-flash
# DeepSeek 双阶段分析可选配置：Flash 负责召回，Pro 负责深度判断。
AI_FAST_MODEL=deepseek-v4-flash
AI_REASONING_MODEL=deepseek-v4-pro
# Optional. Leave empty to use the provider's official default endpoint.
AI_BASE_URL=
