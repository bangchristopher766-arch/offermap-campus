NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider: zhipu | deepseek | dashscope
AI_PROVIDER=zhipu
AI_API_KEY=
AI_MODEL=glm-4.5-flash
# 推荐为不同供应商使用独立密钥，便于安全切换与回退。
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# DeepSeek 交互分析默认统一使用 Flash；需要时可另行提供深度模式。
AI_FAST_MODEL=deepseek-v4-flash
AI_REASONING_MODEL=deepseek-v4-flash
# Optional. Leave empty to use the provider's official default endpoint.
AI_BASE_URL=

# Optional server-only web search for cited position research.
TAVILY_API_KEY=
